# Copy to apps/api/.env for local runs. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Empty = embedded PGlite in .data/pglite (development only)
DATABASE_URL=
AUTH_MODE=dev
# --- Production (Supabase) ---
# AUTH_MODE=supabase
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server only, used for account deletion
# CORS_ORIGINS=https://admin.your-domain.example
# SUPER_ADMIN_EMAILS=you@example.com
# --- Push notifications (Expo) ---
# PUSH=on
# EXPO_ACCESS_TOKEN=   # only if enhanced push security is enabled
# --- Analytics (required in production) ---
# ANALYTICS_SALT=   # random 32+ character secret, keep stable

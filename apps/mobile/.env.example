# Copy to .env.local for local development (never commit real values).
# Without EXPO_PUBLIC_API_URL the app runs fully offline (no account features).
EXPO_PUBLIC_API_URL=http://localhost:4000
# "dev" = local test sign-in against the dev API; "supabase" = email one-time codes
EXPO_PUBLIC_AUTH_MODE=dev
# Required when AUTH_MODE=supabase (the anon key is public by design)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
